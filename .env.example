# Names only. Never commit real values.
# Worker secrets are set with `wrangler secret put <NAME>`; local dev values go in api/.dev.vars (gitignored).

# Postgres connection for role boulderme_api via the Supabase pooler (transaction mode, port 6543)
DATABASE_URL=

# HS256 signing key for access tokens (32+ random bytes, base64)
ACCESS_TOKEN_SIGNING_KEY=

# AES-GCM key for encrypting Apple refresh tokens at rest (32 random bytes, base64)
APPLE_TOKEN_ENCRYPTION_KEY=

# Salt for hashing client installation ids in rate-limit buckets (random, base64)
RATE_LIMIT_SALT=

# Sign in with Apple
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Staging only: key for the end-to-end check's test sign-in (deploy-staging generates one per run)
E2E_IDENTITY_KEY=

# CI / deploy (GitHub Actions secrets)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
STAGING_DATABASE_URL=
