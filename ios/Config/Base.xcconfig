// Shared build settings for every configuration. No secrets here: this file is committed.
// Per-developer overrides (DEVELOPMENT_TEAM, a LAN Worker URL) go in Config/Local.xcconfig,
// which is git-ignored. See ios/README.md.

PRODUCT_NAME = BoulderMe
PRODUCT_BUNDLE_IDENTIFIER = com.zainpi.boulderme$(BUNDLE_ID_SUFFIX)
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SWIFT_VERSION = 5.0
SWIFT_EMIT_LOC_STRINGS = YES

INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = BoulderMe
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
CODE_SIGN_STYLE = Automatic

// Read at runtime through Info.plist (see AppConfig.swift).
// xcconfig treats `//` as a comment, so URLs use `/$()/`.
BM_ENVIRONMENT = production
API_BASE_URL = https:/$()/api.boulderme.app
